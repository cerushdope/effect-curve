{
  "manifest_version": 3,
  "name": "Effect Curve",
  "version": "1.0.0",
  "description": "Log what you took, how much, and when — see the felt effect over time.",
  "minimum_chrome_version": "114",

  "permissions": ["sidePanel"],

  "optional_host_permissions": ["https://qzjvwxuwghegkfxmmseh.supabase.co/*"],

  "side_panel": { "default_path": "app/index.html" },

  "action": { "default_title": "Open Effect Curve" },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": { "service_worker": "background.js" }
}
